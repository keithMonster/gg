<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  gg 夜间自执行（周二 / 四 / 六 23:35 触发）。从客户端 Auto_gg routine 迁来 (2026-05-06)。
  原为每天 22:22（沿用客户端时间）。
  让 gg 在无人在场时整理软外围、巩固当日记忆、跑结构性自查、推进 1 个自选课题。
  软外围可 commit+push；硬核心可改但不 commit（留 working tree 等 Keith review）。

  2026-07-28（Keith 拍）两处变更：
  ① model opus→fable：FOUND 段的跨夜同构模式识别是 fable 的歧义判断强项。
     **未决风险**：auto_gg.md 331 行属重脚手架，官方指出为旧模型写的规定式 prompt
     **often**（常常、非必然）过于规定化并降低 fable 输出质量，
     首轮跑完须比对日志质量再决定是否松脚手架（SCAN 的机械契约不动）。
  ② runner run-task.sh→run-task-and-push.sh：此前 auto-gg 产出只落 gg 日志、
     Keith 不主动看就看不到。改走与 gg-explore 同一范式（外壳抓 stdout 经 notify 推），
     **不在 auto_gg.md 内加 notify**——「被推送不泄漏进 gg 上下文」是 2026-05-16
     设计会话的既定约束；且 auto_gg.md 内 notify 命中为 0，无双推风险。
-->

<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gg.auto-gg</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/xuke/githubProject/gg/scheduled/bin/run-task-and-push.sh</string>
        <string>com.gg.auto-gg</string>
        <string>7200</string>
        <string>Read /Users/xuke/githubProject/gg/auto_gg.md，按其中流程逐步执行</string>
        <string>fable</string>
    </array>

    <!--
      2026-09-09（Keith 拍「统一降频，gg 本来就比较稳定和少用」）两处一起改：
      ① 每天 → 周二/四/六，与 gg-explore 的周一/三/五错开（天天有 gg 在跑，各自隔天）。
         **前置改动**：`scripts/nightly_scan.py` 的变化面窗口原写死 24h，隔天跑会让
         两次之间的仓库变更永远进不了 SCAN（观察面被频率架空）；已改为从本 plist
         的 Weekday 集合派生窗口——改这里的频率，窗口自动跟上，不需要人肉同步。
      ② 22:22 → 23:35：22:22 贴着额度重置窗口，2026-09-02 就因此撞 session limit
         整夜空跑（日志 22:31 exit=1 `resets 10:50pm`）。**不取 23:10**——那槽已被
         `com.monster.infinity-reflect`（fable / 3600s）占着，同起会抢同一个 fable 池。
    -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key>
            <integer>2</integer>
            <key>Hour</key>
            <integer>23</integer>
            <key>Minute</key>
            <integer>35</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>4</integer>
            <key>Hour</key>
            <integer>23</integer>
            <key>Minute</key>
            <integer>35</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>6</integer>
            <key>Hour</key>
            <integer>23</integer>
            <key>Minute</key>
            <integer>35</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>

    <key>WorkingDirectory</key>
    <string>/Users/xuke/githubProject/gg</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/xuke</string>
        <key>PATH</key>
        <string>/Users/xuke/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
